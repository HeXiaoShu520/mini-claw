# 飞书应用凭据（缺失时启动会进入扫码开通向导自动写入）
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 模型配置（供应商由模型名自动推断：带 claude → anthropic、带 deepseek → deepseek、其余 → openai）
FEISHU_PI_MODEL_NAME=deepseek-flash
FEISHU_PI_MODEL_BASE_URL=https://api.deepseek.com
FEISHU_PI_MODEL_API_KEY=

# 思考档位：off / low / high / max（不配置 = off；不同模型自动适配等效等级）
# FEISHU_PI_THINKING_LEVEL=high
# 资源与会话背压（可选）：单个资源 MiB、单条消息总资源 MiB、单会话排队上限
# FEISHU_PI_MAX_RESOURCE_MB=20
# FEISHU_PI_MAX_MESSAGE_RESOURCE_MB=40
# FEISHU_PI_MAX_PENDING_MESSAGES=3

# ask 规则审核模型（OpenAI 兼容）；未配置/失败时回退本人确认，不会放行 deny
FEISHU_GUARD_BASE_URL=
FEISHU_GUARD_MODELS=
FEISHU_GUARD_API_KEY=

# 唯一使用者：中文名、英文名或机器人应用对应的 Open ID。
# 姓名从本地资料缓存唯一匹配；未缓存或重名时填写 Open ID。
FEISHU_PI_ADMIN=

# 浏览器使用本机已安装的 Edge（Windows 默认）或 Chrome。
MINICLAW_BROWSER_CHANNEL=msedge

# 系统提示（身份 + 行为规则）：见 .agent/SYSTEM.md（Pi 原生发现，不入 .env）
